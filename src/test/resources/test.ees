import minecraft

global var event_count = 0

global function debug(text)
  print $"[DEBUG] $text"

function handle(name)
  $event_count = $glob.event_count + 1

  if !isdefined #event.message
    debug "No message"
  elif $event.message == null
    debug "Message is null"
  else
    print $"Message: $event.message"

  var mobs = ["zombie", "creeper"]

  var mob0 = $mobs[0]

  var map = {"a"=1,"b"=2}

  var entry = $map["a"]

  foreach rovar i, rovar mob -> $mobs
    minecraft.spawn $mob {amount=1}

  for rovar i -> 0-5
    print $i

  return
